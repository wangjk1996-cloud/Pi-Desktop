{
  "name": "pi-desktop-app",
  "version": "1.7.2",
  "description": "pi coding agent 的 Windows 桌面客户端，提供多项目标签页、托盘驻留和自动更新。",
  "author": "wangjk1996-cloud",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.github.wangjk1996-cloud.pidesktop",
    "productName": "Pi Desktop",
    "compression": "normal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "strip-preload.js",
      "home-preload.js",
      "overflow-preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/npm-runtime.tar.gz",
        "to": "npm-runtime.tar.gz"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pi Desktop",
      "artifactName": "PiDesktop-${version}-setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wangjk1996-cloud",
        "repo": "Pi-Desktop",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true
  }
}
